# ---------------------------------------------------------------------------
# Vercel Blob (the image + embedding database)
# ---------------------------------------------------------------------------
# Created automatically when you add a Blob store to your Vercel project.
# For local dev, copy it from the Vercel dashboard (Storage > your store > .env.local).
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Face-embedding provider
# ---------------------------------------------------------------------------
# "replicate" = real face recognition via a hosted model (default, recommended)
# "mock"      = deterministic fake embeddings so you can exercise the whole
#               pipeline locally with NO account/key. NOT real matching.
EMBEDDING_PROVIDER=replicate

# --- Replicate settings (used when EMBEDDING_PROVIDER=replicate) ---
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# A face-embedding model reference in the form "owner/name" or "owner/name:version".
# The model must accept an image and return a face embedding vector (and,
# ideally, per-face results). Pick any ArcFace / InsightFace-style embedding
# model on Replicate and paste its full reference here, e.g.:
#   REPLICATE_FACE_MODEL=some-owner/arcface-embeddings:abcdef123...
REPLICATE_FACE_MODEL=

# ---------------------------------------------------------------------------
# Matching tuning (optional)
# ---------------------------------------------------------------------------
# Cosine-similarity threshold below which a result is considered "not a match".
# Range 0..1. Higher = stricter. Tune per model.
MATCH_THRESHOLD=0.35
# Maximum number of results returned by a search.
MATCH_TOP_K=10
